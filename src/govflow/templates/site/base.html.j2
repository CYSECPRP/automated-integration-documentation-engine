<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="govflow {{ version }}">
<title>{{ page_title }} · {{ site_title }}</title>
<link rel="stylesheet" href="{{ root }}style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ root }}index.html"><span class="brand-mark" aria-hidden="true">&gt;_</span> {{ site_title }}</a>
    <nav aria-label="Report">
      <ul>
        <li><a href="{{ root }}index.html"{% if active == "overview" %} aria-current="page"{% endif %}>Overview</a></li>
        <li><a href="{{ root }}policies.html"{% if active == "policies" %} aria-current="page"{% endif %}>Policies</a></li>
        <li><a href="{{ root }}changes.html"{% if active == "changes" %} aria-current="page"{% endif %}>Changes</a></li>
        <li><a href="{{ root }}audit.html"{% if active == "audit" %} aria-current="page"{% endif %}>Audit log</a></li>
        {% for link in links %}
        <li><a href="{{ link.href if link.external else root ~ link.href }}"{% if link.external %} rel="noopener noreferrer"{% endif %}>{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main" class="wrap">
{% block content %}{% endblock %}
</main>
<footer class="wrap footer">
  <p>Generated by <strong>govflow {{ version }}</strong> from run <code>{{ info.run_id }}</code> on {{ info.finished_at|ts }}. Audit chain {% if verification.ok %}<span class="ok">verified</span>{% else %}<span class="bad">broken</span>{% endif %} &middot; <a href="{{ root }}report.json">report.json</a> &middot; <a href="{{ root }}report.md">report.md</a></p>
</footer>
</body>
</html>
